---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'We Are One: Haiti World Cup Weekend' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="We Are One: Haiti World Cup Weekend — Celebrating Haiti. Honoring freedom. Uniting cultures. A two-day cultural experience in Atlanta, GA." />
    <meta name="theme-color" content="#003580" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
