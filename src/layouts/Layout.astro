---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'New Dawn of Gaming: Panama vs England' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="New Dawn of Gaming: Panama vs England — A single-day fireside chat, live match viewing, and competitive gaming tournament exploring responsible gaming and cross-Atlantic financial opportunity." />
    <meta name="theme-color" content="#0d1e3a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
