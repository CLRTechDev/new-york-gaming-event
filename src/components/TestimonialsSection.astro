---
const statements = [
  {
    name: 'The Responsible Gaming Mandate',
    role: 'Event Mission',
    photo: 'https://images.pexels.com/photos/3183197/pexels-photo-3183197.jpeg?auto=compress&fit=crop&w=68&h=68&q=80',
    quote:
      'Responsible gaming is not a constraint on the industry — it is the foundation of its long-term credibility. This event exists to advance that conversation at the highest level.',
  },
  {
    name: 'The Cross-Atlantic Opportunity',
    role: 'Financial Corridors',
    photo: 'https://images.pexels.com/photos/3183150/pexels-photo-3183150.jpeg?auto=compress&fit=crop&w=68&h=68&q=80',
    quote:
      'Panama and the United Kingdom represent two sides of an emerging corridor — one offering regulatory maturity, the other geographic and fiscal advantage. The intersection is where opportunity lives.',
  },
  {
    name: 'Sport as a Capital Market',
    role: 'Investment Lens',
    photo: 'https://images.pexels.com/photos/1080885/pexels-photo-1080885.jpeg?auto=compress&fit=crop&w=68&h=68&q=80',
    quote:
      'Football is no longer just culture. It is infrastructure, media, data, and capital. The World Cup is the moment when these worlds converge — and so is this event.',
  },
  {
    name: 'Gaming as a Serious Business',
    role: 'Industry Framing',
    photo: 'https://images.pexels.com/photos/7862608/pexels-photo-7862608.jpeg?auto=compress&fit=crop&w=68&h=68&q=80',
    quote:
      'The global gaming market exceeds $500 billion. Treating it with the same rigour as traditional finance — with consumer protection and regulatory frameworks — is not optional. It is inevitable.',
  },
  {
    name: 'Partnership Value',
    role: 'Brand Opportunity',
    photo: 'https://images.pexels.com/photos/3183132/pexels-photo-3183132.jpeg?auto=compress&fit=crop&w=68&h=68&q=80',
    quote:
      'Partners gain direct access to a curated audience of financial decision-makers, regulators, and innovators — in a setting that rewards conversation, not just exposure.',
  },
  {
    name: 'Play With Purpose',
    role: 'Tournament Philosophy',
    photo: 'https://images.pexels.com/photos/3165335/pexels-photo-3165335.jpeg?auto=compress&fit=crop&w=68&h=68&q=80',
    quote:
      "The evening tournament isn't about escapism. It's a demonstration — showing that competitive gaming, done responsibly, is a legitimate and joyful extension of the day's themes.",
  },
];

const topRow = statements.slice(0, 3);
const bottomRow = statements.slice(3);
---

<section class="testimonials-section" aria-labelledby="testimonials-title">
  <div class="testimonials-wrap">
    <h2 id="testimonials-title" class="testimonials-title">Why New Dawn of Gaming Matters</h2>

    <div class="marquee-row">
      <div class="marquee-track marquee-track-forward">
        {[...topRow, ...topRow].map((item) => (
          <article class="testimonial-card">
            <p class="quote-mark" aria-hidden="true">"</p>
            <p class="quote">{item.quote}</p>

            <div class="person-row">
              <img src={item.photo} alt={item.name} loading="lazy" />
              <div>
                <p class="name">{item.name}</p>
                <p class="role">{item.role}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="marquee-row">
      <div class="marquee-track marquee-track-reverse">
        {[...bottomRow, ...bottomRow].map((item) => (
          <article class="testimonial-card">
            <p class="quote-mark" aria-hidden="true">"</p>
            <p class="quote">{item.quote}</p>

            <div class="person-row">
              <img src={item.photo} alt={item.name} loading="lazy" />
              <div>
                <p class="name">{item.name}</p>
                <p class="role">{item.role}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.testimonials-section {
  background: #f2f3f5;
  padding: 2.4rem 0 4.6rem;
}

.testimonials-wrap {
  width: 100%;
  display: grid;
  gap: 1rem;
}

.testimonials-title {
  margin: 0;
  text-align: center;
  color: #131a20;
  font-family: "Space Grotesk", "Segoe UI", sans-serif;
  font-size: clamp(1.8rem, 3.2vw, 2.7rem);
  line-height: 1.04;
  letter-spacing: -0.018em;
}

.marquee-row {
  position: relative;
  overflow: hidden;
  padding-inline: 0.8rem;
}

.marquee-row::before,
.marquee-row::after {
  content: "";
  position: absolute;
  top: 0;
  width: 56px;
  height: 100%;
  z-index: 2;
  pointer-events: none;
}

.marquee-row::before {
  left: 0;
  background: linear-gradient(90deg, #f2f3f5, rgba(242, 243, 245, 0));
}

.marquee-row::after {
  right: 0;
  background: linear-gradient(270deg, #f2f3f5, rgba(242, 243, 245, 0));
}

.marquee-track {
  display: flex;
  gap: 0.9rem;
  width: max-content;
  will-change: transform;
}

.marquee-track-forward {
  animation: testimonials-left 24s linear infinite;
}

.marquee-track-reverse {
  animation: testimonials-left 24s linear infinite reverse;
}

.testimonial-card {
  width: clamp(260px, 30vw, 410px);
  min-height: 210px;
  background: #eceef2;
  border: 1px solid #e0e4ea;
  border-radius: 14px;
  padding: 1rem 1.05rem;
  color: #161d24;
  display: grid;
  grid-template-rows: auto 1fr auto;
}

.quote-mark {
  margin: 0;
  color: #0d1e3a;
  font-size: 2.8rem;
  line-height: 1;
  font-family: Georgia, "Times New Roman", serif;
}

.quote {
  margin: 0.2rem 0 0;
  font-size: 1.03rem;
  line-height: 1.42;
  color: #222a31;
}

.person-row {
  margin-top: 0.9rem;
  display: flex;
  align-items: center;
  gap: 0.65rem;
}

.person-row img {
  width: 34px;
  height: 34px;
  border-radius: 999px;
  object-fit: cover;
}

.name {
  margin: 0;
  font-weight: 700;
  font-size: 1rem;
  line-height: 1.2;
}

.role {
  margin: 0.15rem 0 0;
  font-size: 0.8rem;
  color: #8a919a;
}

@keyframes testimonials-left {
  from { transform: translateX(0); }
  to { transform: translateX(calc(-50% - 0.45rem)); }
}

@media (max-width: 720px) {
  .testimonial-card {
    width: clamp(238px, 74vw, 320px);
    min-height: 200px;
  }

  .quote {
    font-size: 0.97rem;
  }

  .marquee-track-forward,
  .marquee-track-reverse {
    animation-duration: 28s;
  }
}

@media (prefers-reduced-motion: reduce) {
  .marquee-track-forward,
  .marquee-track-reverse {
    animation: none;
  }
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}
</style>
