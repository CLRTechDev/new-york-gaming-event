---
const statements = [
  {
    name: 'Cultural Platform',
    role: 'Event Mission',
    photo: 'https://images.pexels.com/photos/3171837/pexels-photo-3171837.jpeg?auto=compress&fit=crop&w=68&h=68&q=80',
    quote:
      'This event is more than a festival. It is a platform to celebrate Haitian excellence and identity, honor freedom during Juneteenth weekend, and establish a culturally significant annual event in Atlanta.',
  },
  {
    name: 'Sponsor Opportunity',
    role: 'Brand Partnership',
    photo: 'https://images.pexels.com/photos/1684187/pexels-photo-1684187.jpeg?auto=compress&fit=crop&w=68&h=68&q=80',
    quote:
      'The weekend offers a strong platform for multicultural audience engagement, family-centered community reach, premium VIP access, experiential brand activations, and high-visibility media moments.',
  },
  {
    name: 'Community Impact',
    role: 'Saturday Festival',
    photo: 'https://images.pexels.com/photos/2263436/pexels-photo-2263436.jpeg?auto=compress&fit=crop&w=68&h=68&q=80',
    quote:
      'Saturday is the public-facing flagship experience — vibrant, energetic, family-friendly, and highly visual. Designed for approximately 5,000 attendees, it operates like a destination event for the whole weekend.',
  },
  {
    name: 'Friday Prestige',
    role: 'Unity Gala',
    photo: 'https://images.pexels.com/photos/1190297/pexels-photo-1190297.jpeg?auto=compress&fit=crop&w=68&h=68&q=80',
    quote:
      'Friday is the elevated opening experience — red carpet, stylish, curated, culturally rich, and press-worthy. Its job is to welcome sponsors and invited guests and frame the weekend with meaning.',
  },
  {
    name: 'Haitian Pride',
    role: 'Cultural Identity',
    photo: 'https://images.pexels.com/photos/2078076/pexels-photo-2078076.jpeg?auto=compress&fit=crop&w=68&h=68&q=80',
    quote:
      'The experience brings people together through Haitian pride, cultural celebration, music, food, family, and global connection through football — polished enough for sponsors, joyful enough for everyone.',
  },
  {
    name: 'Long-Term Vision',
    role: 'Annual Event',
    photo: 'https://images.pexels.com/photos/1105666/pexels-photo-1105666.jpeg?auto=compress&fit=crop&w=68&h=68&q=80',
    quote:
      'This event should feel like a movement in celebration form. Friday establishes prestige. Saturday delivers the public celebration. Together, they create a signature weekend with strong community meaning and long-term growth potential.',
  },
];

const topRow = statements.slice(0, 3);
const bottomRow = statements.slice(3);
---

<section class="testimonials-section" aria-labelledby="testimonials-title">
  <div class="testimonials-wrap">
    <h2 id="testimonials-title" class="testimonials-title">Why We Are One Matters</h2>

    <div class="marquee-row">
      <div class="marquee-track marquee-track-forward">
        {[...topRow, ...topRow].map((item) => (
          <article class="testimonial-card">
            <p class="quote-mark" aria-hidden="true">"</p>
            <p class="quote">{item.quote}</p>

            <div class="person-row">
              <img src={item.photo} alt={item.name} loading="lazy" />
              <div>
                <p class="name">{item.name}</p>
                <p class="role">{item.role}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="marquee-row">
      <div class="marquee-track marquee-track-reverse">
        {[...bottomRow, ...bottomRow].map((item) => (
          <article class="testimonial-card">
            <p class="quote-mark" aria-hidden="true">"</p>
            <p class="quote">{item.quote}</p>

            <div class="person-row">
              <img src={item.photo} alt={item.name} loading="lazy" />
              <div>
                <p class="name">{item.name}</p>
                <p class="role">{item.role}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.testimonials-section {
  background: #f2f3f5;
  padding: 2.4rem 0 4.6rem;
}

.testimonials-wrap {
  width: 100%;
  display: grid;
  gap: 1rem;
}

.testimonials-title {
  margin: 0;
  text-align: center;
  color: #131a20;
  font-family: "Space Grotesk", "Segoe UI", sans-serif;
  font-size: clamp(1.8rem, 3.2vw, 2.7rem);
  line-height: 1.04;
  letter-spacing: -0.018em;
}

.marquee-row {
  position: relative;
  overflow: hidden;
  padding-inline: 0.8rem;
}

.marquee-row::before,
.marquee-row::after {
  content: "";
  position: absolute;
  top: 0;
  width: 56px;
  height: 100%;
  z-index: 2;
  pointer-events: none;
}

.marquee-row::before {
  left: 0;
  background: linear-gradient(90deg, #f2f3f5, rgba(242, 243, 245, 0));
}

.marquee-row::after {
  right: 0;
  background: linear-gradient(270deg, #f2f3f5, rgba(242, 243, 245, 0));
}

.marquee-track {
  display: flex;
  gap: 0.9rem;
  width: max-content;
  will-change: transform;
}

.marquee-track-forward {
  animation: testimonials-left 24s linear infinite;
}

.marquee-track-reverse {
  animation: testimonials-left 24s linear infinite reverse;
}

.testimonial-card {
  width: clamp(260px, 30vw, 410px);
  min-height: 210px;
  background: #eceef2;
  border: 1px solid #e0e4ea;
  border-radius: 14px;
  padding: 1rem 1.05rem;
  color: #161d24;
  display: grid;
  grid-template-rows: auto 1fr auto;
}

.quote-mark {
  margin: 0;
  color: #003580;
  font-size: 2.8rem;
  line-height: 1;
  font-family: Georgia, "Times New Roman", serif;
}

.quote {
  margin: 0.2rem 0 0;
  font-size: 1.03rem;
  line-height: 1.42;
  color: #222a31;
}

.person-row {
  margin-top: 0.9rem;
  display: flex;
  align-items: center;
  gap: 0.65rem;
}

.person-row img {
  width: 34px;
  height: 34px;
  border-radius: 999px;
  object-fit: cover;
}

.name {
  margin: 0;
  font-weight: 700;
  font-size: 1rem;
  line-height: 1.2;
}

.role {
  margin: 0.15rem 0 0;
  font-size: 0.8rem;
  color: #8a919a;
}

@keyframes testimonials-left {
  from { transform: translateX(0); }
  to { transform: translateX(calc(-50% - 0.45rem)); }
}

@media (max-width: 720px) {
  .testimonial-card {
    width: clamp(238px, 74vw, 320px);
    min-height: 200px;
  }

  .quote {
    font-size: 0.97rem;
  }

  .marquee-track-forward,
  .marquee-track-reverse {
    animation-duration: 28s;
  }
}

@media (prefers-reduced-motion: reduce) {
  .marquee-track-forward,
  .marquee-track-reverse {
    animation: none;
  }
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}
</style>
