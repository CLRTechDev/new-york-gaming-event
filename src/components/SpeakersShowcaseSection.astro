  {
    slug: 'responsible-gaming',
    name: 'Responsible Gaming Frameworks',
    role: 'How jurisdictions are shaping regulation, consumer protection standards, and operator accountability across the Atlantic',
    company: 'Policy & Regulation',
    icon: '🛡',
    image: 'https://images.pexels.com/photos/3183197/pexels-photo-3183197.jpeg?auto=compress&fit=crop&w=1200&q=90',
  },
  {
    slug: 'panama-finance',
    name: 'Panama as a Financial Hub',
    role: "Exploring Panama's positioning as a cross-Atlantic bridge for fintech, gaming capital, and international financial services",
    company: 'Finance & Markets',
    icon: '🇵🇦',
    image: 'https://images.pexels.com/photos/3183150/pexels-photo-3183150.jpeg?auto=compress&fit=crop&w=1200&q=90',
  },
  {
    slug: 'uk-gaming',
