---

<section class="speakers-showcase" id="speakers" aria-labelledby="speakers-title">
  <div class="container speakers-wrap">
    <div class="section-head">
      <div class="section-copy">
        <h2 id="speakers-title">Seven Sessions<br />Shaping the<br />New Dawn</h2>
        <p>
          Each session is designed to spark real conversation — on regulation, opportunity, capital, and the future where sport and finance intersect.
        </p>
      </div>
    </div>

    <div class="carousel-shell" data-speaker-carousel>
      <button class="carousel-nav carousel-nav-prev" type="button" data-dir="prev" aria-label="Previous sessions">
        <span aria-hidden="true">←</span>
      </button>

      <div class="speakers-viewport">
        <div class="speakers-track" data-speaker-track role="list" aria-label="Event sessions">
          {sessions.map((session) => (
            <a href={`/zones/${session.slug}`} class="speaker-card" role="listitem">
              <div class="portrait-wrap">
                <img src={session.image} alt={session.name} loading="lazy" />
                <span class="zone-badge" aria-hidden="true">{session.icon}</span>
              </div>

              <div class="card-meta">
                <h3>{session.name}</h3>
                <p class="role">{session.role}</p>

                <div class="company-row">
                  <span class="company-logo" aria-hidden="true">{session.icon}</span>
                  <span class="company-name">{session.company}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <button class="carousel-nav carousel-nav-next" type="button" data-dir="next" aria-label="Next sessions">
        <span aria-hidden="true">→</span>
      </button>
    </div>

    <a class="see-all-btn" href="/sponsorship">Become a Session Partner →</a>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-speaker-carousel]');
    if (!root) return;

    const track = root.querySelector('[data-speaker-track]');
    const prevBtn = root.querySelector('[data-dir="prev"]');
    const nextBtn = root.querySelector('[data-dir="next"]');
    if (!track || !prevBtn || !nextBtn) return;

    const cards = Array.from(track.querySelectorAll('.speaker-card'));
    let activeIndex = 0;

    const getCardsPerView = () => {
      if (window.matchMedia('(max-width: 640px)').matches) return 1;
      if (window.matchMedia('(max-width: 980px)').matches) return 2;
      return 4;
    };

    const getStep = () => {
      const firstCard = cards[0];
      if (!firstCard) return 0;
      const gap = parseFloat(getComputedStyle(track).gap || '0');
      return firstCard.getBoundingClientRect().width + gap;
    };

    const updateButtons = () => {
      const cardsPerView = getCardsPerView();
      const maxIndex = Math.max(0, cards.length - cardsPerView);
      prevBtn.disabled = activeIndex <= 0;
      nextBtn.disabled = activeIndex >= maxIndex;
      root.classList.toggle('is-static', cards.length <= cardsPerView);
    };

    const apply = () => {
      const cardsPerView = getCardsPerView();
      const maxIndex = Math.max(0, cards.length - cardsPerView);
      activeIndex = Math.min(activeIndex, maxIndex);
      const step = getStep();
      track.style.transform = `translate3d(-${activeIndex * step}px, 0, 0)`;
      updateButtons();
    };

    prevBtn.addEventListener('click', () => {
      activeIndex = Math.max(0, activeIndex - 1);
      apply();
    });

    nextBtn.addEventListener('click', () => {
      const cardsPerView = getCardsPerView();
      const maxIndex = Math.max(0, cards.length - cardsPerView);
      activeIndex = Math.min(maxIndex, activeIndex + 1);
      apply();
    });

    window.addEventListener('resize', apply);
    apply();
  })();
</script>

<style>
.speakers-showcase {
  background: #f7f6f4;
  position: relative;
  padding: 5.1rem 0 5.5rem;
}

.speakers-wrap {
  width: min(1220px, 94%);
}

.section-head {
  display: block;
  margin-bottom: 1.65rem;
}

.section-copy {
  max-width: 760px;
}

.section-copy h2 {
  margin: 0;
  font-size: clamp(2.2rem, 4.9vw, 4.25rem);
  line-height: 0.92;
  letter-spacing: -0.045em;
  color: #202328;
  font-weight: 500;
  font-family: "Space Grotesk", "IBM Plex Sans", "Segoe UI", sans-serif;
}

.section-copy p {
  margin: 1.05rem 0 0;
  max-width: 38ch;
  color: #31363d;
  font-size: clamp(1.02rem, 1.1vw, 1.18rem);
  line-height: 1.55;
}

.carousel-shell {
  position: relative;
}

.speakers-viewport {
  overflow: hidden;
}

.speakers-track {
  display: flex;
  gap: 1.15rem;
