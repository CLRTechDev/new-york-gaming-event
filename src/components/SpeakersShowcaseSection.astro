    company: 'Sports Finance',
    icon: '⚽',
    image: 'https://images.pexels.com/photos/1080885/pexels-photo-1080885.jpeg?auto=compress&fit=crop&w=1200&q=90',
  },
  {
    slug: 'fintech-gaming',
