  border-radius: 14px;
  border: 1px solid #dedde0;
  background: #fcfcfc;
  box-shadow: 0 8px 18px rgba(19, 25, 38, 0.05);
  transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  overflow: hidden;
}

.speaker-card:hover {
  transform: translateY(-4px);
  border-color: #d3d2d8;
  box-shadow: 0 16px 34px rgba(14, 20, 33, 0.08);
}

.carousel-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  width: 2.65rem;
  height: 2.65rem;
  border: 1px solid #d8d6db;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.92);
  color: #1a1d22;
  display: grid;
  place-items: center;
  box-shadow: 0 10px 24px rgba(18, 20, 30, 0.08);
  cursor: pointer;
}

.carousel-nav:disabled {
  opacity: 0.4;
