---
const zones = [
  { name: 'Unity Main Stage', fallback: '🎤', color: '#003580' },
  { name: 'Champions Lounge', fallback: '🥂', color: '#ce1126' },
  { name: 'Global Bites Food Fest', fallback: '🍽', color: '#f5a623' },
  { name: 'Kids Zone', fallback: '⚽', color: '#27ae60' },
  { name: 'Unity Marketplace', fallback: '🛍', color: '#8e44ad' },
];

const moreZones = [
  { name: 'Champions Circle', fallback: '★', color: '#003580' },
  { name: 'Culture Connect', fallback: '🌍', color: '#ce1126' },
];
---

<section class="noise-stage" id="lineup" aria-labelledby="noise-stage-title">
  <div class="noise-shell container">
    <span class="noise-kicker reveal-line" style="--reveal-delay: 0s;">Juneteenth Weekend · Atlanta, GA</span>
    <h2 id="noise-stage-title" class="noise-title reveal-line" style="--reveal-delay: 0.12s;">
      Two Days.
      <span>One City. One Purpose.</span>
    </h2>
    <p class="noise-copy reveal-line" style="--reveal-delay: 0.24s;">
      We Are One: Haiti World Cup Weekend is a two-day signature cultural experience celebrating Haiti on the world stage while honoring freedom, family, and multicultural unity during Juneteenth weekend in Atlanta.
    </p>

    <article class="schedule-card reveal-line" style="--reveal-delay: 0.36s;" aria-label="Weekend schedule">
      <div class="schedule-day">
        <div class="day-header">
          <span class="day-label">Friday · The Unity Gala</span>
          <span class="day-badge">VIP &amp; Sponsors</span>
        </div>
        <div class="day-times">
          <div class="time-row"><span class="time">5:30 PM</span><span class="event">Freedom Walk red carpet arrival &amp; media</span></div>
          <div class="time-row"><span class="time">6:30 PM</span><span class="event">Welcome reception &amp; sponsor networking</span></div>
          <div class="time-row"><span class="time">7:00 PM</span><span class="event">Opening ceremony &amp; cultural remarks</span></div>
          <div class="time-row"><span class="time">7:20 PM</span><span class="event">Cultural showcase, honors &amp; entertainment</span></div>
          <div class="time-row"><span class="time">8:45 PM</span><span class="event">VIP networking &amp; closing celebration</span></div>
        </div>
      </div>
      <div class="schedule-divider" aria-hidden="true"></div>
      <div class="schedule-day">
        <div class="day-header">
          <span class="day-label">Saturday · We Are One Festival</span>
          <span class="day-badge">~5,000 Attendees</span>
        </div>
        <div class="day-times">
          <div class="time-row"><span class="time">11:00 AM</span><span class="event">Festival gates open to the public</span></div>
          <div class="time-row"><span class="time">11:30 AM</span><span class="event">Performances, food fest &amp; kids zone</span></div>
          <div class="time-row"><span class="time">3:00 PM</span><span class="event">Featured cultural moment &amp; sponsor spotlight</span></div>
          <div class="time-row"><span class="time">4:00 PM</span><span class="event">Headline entertainment &amp; peak programming</span></div>
          <div class="time-row"><span class="time">6:00 PM</span><span class="event">Family closeout &amp; final activations</span></div>
        </div>
      </div>
    </article>

    <section class="brand-showcase" aria-labelledby="brand-showcase-title">
      <p id="brand-showcase-title" class="brand-note reveal-line" style="--reveal-delay: 0.36s;">Experience Zones</p>

      <div class="brand-row reveal-line" style="--reveal-delay: 0.48s;">
        {
          zones.map((zone, index) => (
            <span
              class="brand-icon"
              aria-label={zone.name}
              title={zone.name}
              style={`--brand-tone: ${zone.color}; --icon-delay: ${0.74 + index * 0.08}s;`}
            >
              <span class="brand-fallback">{zone.fallback}</span>
            </span>
          ))
        }
      </div>

      <div class="brand-row brand-row-subtle reveal-line" style="--reveal-delay: 0.58s;">
        {
          moreZones.map((zone, index) => (
            <span
              class="brand-icon"
              aria-label={zone.name}
              title={zone.name}
              style={`--brand-tone: ${zone.color}; --icon-delay: ${1.1 + index * 0.08}s;`}
            >
              <span class="brand-fallback">{zone.fallback}</span>
            </span>
          ))
        }
        <span class="brand-icon brand-icon-more" aria-label="And more" style="--icon-delay: 1.36s;">+</span>
      </div>
    </section>
  </div>

  <div class="decor decor-left" aria-hidden="true"></div>
  <div class="decor decor-right" aria-hidden="true"></div>
  <div class="cross cross-left" aria-hidden="true"></div>
  <div class="cross cross-right" aria-hidden="true"></div>
  <div class="noise-dot noise-dot-a" aria-hidden="true"></div>
  <div class="noise-dot noise-dot-b" aria-hidden="true"></div>
  <div class="noise-arc noise-arc-a" aria-hidden="true"></div>
  <div class="noise-arc noise-arc-b" aria-hidden="true"></div>
</section>

<script>
  const noiseStage = document.querySelector('.noise-stage');

  if (noiseStage) {
    const stageObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          noiseStage.classList.add('is-visible');
        }
      },
      { threshold: 0.25 }
    );

    stageObserver.observe(noiseStage);
  }
</script>

<style>
.noise-stage {
  position: relative;
  overflow: hidden;
  background-color: #0a1928;
  background-image: linear-gradient(180deg, #0a1928 0%, #0d2040 42%, #071320 100%);
  background-size: 130% 130%;
  color: #eef3f6;
  margin-top: -340px;
  padding: 260px 0 3.8rem;
  clip-path: polygon(
    0 16%,
    8% 14%,
    22% 12%,
    36% 10%,
    50% 9%,
    64% 10%,
    78% 12%,
    92% 14%,
    100% 16%,
    100% 100%,
    0 100%
  );
  animation: gradient-shift 12.9s ease-in-out infinite alternate;
}

.noise-shell {
  position: relative;
  z-index: 2;
  padding-top: 5.6rem;
  text-align: center;
}

.noise-kicker {
  text-transform: uppercase;
  letter-spacing: 0.3em;
  font-size: 0.88rem;
  color: #d2d9dd;
  font-weight: 700;
}

.noise-title {
  margin: 0.7rem auto 0;
  font-family: "Space Grotesk", "Segoe UI", sans-serif;
  font-size: clamp(2rem, 5vw, 3.7rem);
  line-height: 1.02;
  text-transform: uppercase;
  font-weight: 500;
  max-width: 15ch;
}

.noise-title span {
  color: #ce1126;
}

.noise-copy {
  margin: 0.85rem auto 0;
  font-size: clamp(1rem, 1.55vw, 1.2rem);
  color: #d7dde2;
  max-width: 52ch;
}

.schedule-card {
  margin: 2rem auto 0;
  max-width: min(920px, 92%);
  border: 1px solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
  background: rgba(0, 0, 0, 0.3);
  border-radius: 12px;
  padding: 1.4rem;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 0;
  text-align: left;
}

.schedule-day {
  padding: 0.5rem 1rem;
}

.day-header {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex-wrap: wrap;
  margin-bottom: 0.9rem;
}

.day-label {
  font-weight: 700;
  font-size: 1rem;
  color: #f0f4f7;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.day-badge {
  font-size: 0.72rem;
  font-weight: 700;
  padding: 0.2rem 0.55rem;
  border-radius: 999px;
  background: rgba(206, 17, 38, 0.25);
  color: #ff8a95;
  border: 1px solid rgba(206, 17, 38, 0.4);
  white-space: nowrap;
}

.day-times {
  display: grid;
  gap: 0.55rem;
}

.time-row {
  display: grid;
  grid-template-columns: 4.5rem 1fr;
  gap: 0.7rem;
  align-items: baseline;
}

.time {
  font-size: 0.82rem;
  font-weight: 700;
  color: #ce1126;
  white-space: nowrap;
}

.event {
  font-size: 0.88rem;
  color: #c8d0d6;
  line-height: 1.35;
}

.schedule-divider {
  width: 1px;
  background: rgba(255, 255, 255, 0.12);
  margin: 0 0.5rem;
}

.reveal-line {
  opacity: 0;
  transform: translate3d(0, 18px, 0);
  filter: blur(8px);
  transition:
    opacity 0.8s ease,
    transform 0.8s cubic-bezier(0.2, 0.75, 0.2, 1),
    filter 0.8s ease;
  transition-delay: var(--reveal-delay, 0s);
  will-change: opacity, transform, filter;
}

.noise-stage.is-visible .reveal-line {
  opacity: 1;
  transform: translate3d(0, 0, 0);
  filter: blur(0);
}

.brand-note {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-size: 2rem;
  color: #d7dce0;
  font-weight: 700;
}

.brand-showcase {
  position: relative;
  margin: 3.2rem auto 0;
  padding: 1.1rem 0 0.25rem;
  max-width: 980px;
}

.brand-showcase::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -34px;
  transform: translateX(-50%);
  width: min(960px, 95vw);
  height: 320px;
  background: repeating-radial-gradient(
    ellipse at 50% 100%,
    rgba(186, 194, 201, 0.15) 0 1px,
    transparent 1px 20px
  );
  opacity: 0.42;
  pointer-events: none;
}

.brand-row {
  margin-top: 1.55rem;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 2rem;
  flex-wrap: wrap;
  color: #f4f7fa;
  font-weight: 700;
  font-size: clamp(1.05rem, 1.9vw, 2rem);
  letter-spacing: 0.01em;
  position: relative;
  z-index: 1;
}

.brand-icon {
  width: 56px;
  height: 56px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255, 255, 255, 0.22);
  background: linear-gradient(160deg, color-mix(in srgb, var(--brand-tone, #003580) 52%, #0d1620 48%), rgba(8, 15, 24, 0.92));
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  opacity: 0;
  transform: translate3d(0, 14px, 0) scale(0.82);
  filter: blur(6px);
  will-change: transform, opacity, filter;
  transition:
    transform 0.26s cubic-bezier(0.2, 0.8, 0.2, 1),
    box-shadow 0.26s ease,
    border-color 0.26s ease,
    background 0.26s ease;
}

.noise-stage.is-visible .brand-icon {
  animation: icon-reveal 0.62s cubic-bezier(0.2, 0.78, 0.18, 1) forwards;
  animation-delay: var(--icon-delay, 0s);
}

.brand-icon:hover {
  transform: translate3d(0, -4px, 0) scale(1.06);
  border-color: color-mix(in srgb, var(--brand-tone, #003580) 62%, #eef4f8 38%);
  box-shadow:
    0 8px 22px color-mix(in srgb, var(--brand-tone, #003580) 42%, transparent 58%),
    inset 0 0 0 1px rgba(255, 255, 255, 0.14);
}

.brand-fallback {
  font-size: 1.3rem;
  line-height: 1;
  font-weight: 800;
  color: #ecf3f7;
  transition: transform 0.26s ease;
}

.brand-icon-more {
  font-size: 1.7rem;
  line-height: 1;
  color: #f4f7fa;
  font-weight: 600;
}

.brand-row-subtle {
  margin-top: 1rem;
  color: #cfd7dd;
  font-size: clamp(0.95rem, 1.55vw, 1.6rem);
}

.decor {
  position: absolute;
  border-radius: 999px;
  pointer-events: none;
  z-index: 1;
}

.decor-left {
  width: 500px;
  height: 500px;
  border: 26px solid rgba(0, 53, 128, 0.75);
  left: -260px;
  top: 370px;
  box-shadow:
    inset 0 0 0 10px rgba(255, 255, 255, 0.74),
    inset 0 0 0 44px rgba(0, 0, 0, 0.4);
  animation: float-left 6.4s ease-in-out infinite;
}

.decor-right {
  width: 580px;
  height: 580px;
  border: 38px solid rgba(206, 17, 38, 0.74);
  right: -200px;
  top: 150px;
  box-shadow: inset 0 0 0 10px rgba(255, 255, 255, 0.28);
  animation: float-right 7.9s ease-in-out infinite;
}

.cross {
  position: absolute;
  width: 95px;
  height: 95px;
  opacity: 0.6;
  z-index: 1;
}

.cross::before,
.cross::after {
  content: "";
  position: absolute;
  background: rgba(206, 17, 38, 0.72);
}

.cross::before {
  width: 2px;
  height: 100%;
  left: 50%;
  top: 0;
}

.cross::after {
  height: 2px;
  width: 100%;
  top: 50%;
  left: 0;
}

.cross-left {
  left: 50px;
  bottom: 120px;
  animation: cross-pulse 3.3s ease-in-out infinite;
}

.cross-right {
  right: 70px;
  top: 260px;
  animation: cross-pulse 3.7s ease-in-out infinite;
}

.noise-dot {
  position: absolute;
  border-radius: 999px;
  pointer-events: none;
  z-index: 1;
}

.noise-dot-a {
  width: 18px;
  height: 18px;
  left: 22%;
  top: 190px;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 0 0 10px rgba(0, 53, 128, 0.18);
  animation: dot-bob 3.6s ease-in-out infinite;
}

.noise-dot-b {
  width: 28px;
  height: 28px;
  right: 19%;
  bottom: 170px;
  background: rgba(206, 17, 38, 0.9);
  box-shadow: 0 0 0 12px rgba(255, 255, 255, 0.08);
  animation: dot-bob 4.3s ease-in-out infinite reverse;
}

.noise-arc {
  position: absolute;
  pointer-events: none;
  z-index: 1;
  border: 3px solid rgba(255, 255, 255, 0.22);
  border-radius: 999px;
}

.noise-arc-a {
  width: 180px;
  height: 180px;
  right: 24%;
  top: 120px;
  border-left-color: transparent;
  border-bottom-color: transparent;
  transform: rotate(14deg);
  animation: arc-sway 5.6s ease-in-out infinite;
}

.noise-arc-b {
  width: 120px;
  height: 120px;
  left: 10%;
  bottom: 90px;
  border-right-color: transparent;
  border-top-color: transparent;
  transform: rotate(-18deg);
  opacity: 0.45;
  animation: arc-sway 5s ease-in-out infinite reverse;
}

@keyframes gradient-shift {
  0% { background-position: 0% 35%; }
  100% { background-position: 100% 65%; }
}

@keyframes float-left {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  50% { transform: translate3d(10px, -10px, 0) rotate(2deg); }
}

@keyframes float-right {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  50% { transform: translate3d(-12px, 12px, 0) rotate(-2deg); }
}

@keyframes cross-pulse {
  0%, 100% { opacity: 0.45; transform: scale(1); }
  50% { opacity: 0.85; transform: scale(1.06); }
}

@keyframes dot-bob {
  0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
  50% { transform: translate3d(0, -10px, 0) scale(1.08); }
}

@keyframes arc-sway {
  0%, 100% { transform: translate3d(0, 0, 0) rotate(14deg); }
  50% { transform: translate3d(0, -8px, 0) rotate(8deg); }
}

@keyframes icon-reveal {
  0% { opacity: 0; transform: translate3d(0, 14px, 0) scale(0.82); filter: blur(6px); }
  75% { opacity: 1; transform: translate3d(0, -2px, 0) scale(1.04); filter: blur(0); }
  100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); filter: blur(0); }
}

@media (max-width: 900px) {
  .noise-stage {
    margin-top: -120px;
    padding-top: 120px;
    clip-path: polygon(
      0 14%, 8% 12%, 22% 10%, 36% 8%, 50% 7%,
      64% 8%, 78% 10%, 92% 12%, 100% 14%,
      100% 100%, 0 100%
    );
  }

  .noise-shell {
    padding-top: 4.6rem;
  }

  .schedule-card {
    grid-template-columns: 1fr;
  }

  .schedule-divider {
    width: 100%;
    height: 1px;
    margin: 0.8rem 0;
  }

  .decor-right {
    width: 360px;
    height: 360px;
    border-width: 24px;
    right: -140px;
    top: 260px;
  }

  .decor-left {
    width: 320px;
    height: 320px;
    border-width: 16px;
    left: -160px;
    top: 460px;
  }

  .brand-note {
    font-size: 1.3rem;
    letter-spacing: 0.14em;
  }

  .brand-row {
    gap: 1rem;
  }

  .brand-icon {
    width: 46px;
    height: 46px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .brand-icon {
    opacity: 1;
    transform: none;
    filter: none;
    animation: none !important;
    transition: none;
  }
}
</style>
